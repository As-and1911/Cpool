** My_sort_int_array.c
**File description :
**A function that sorts an integer array in ascending order 
*/
void my_putchar(char c);
int get_min(int *array, int size)
{
    int i = 0;
    int idx_min = 0;
    while (i < size) {
        if (array[i] < array[idx_min]) {
            idx_min = i;
        }
        i++;
    }
    return idx_min;
}
void my_swap_int(int *a, int *b)
{
    int temp = *a;
    *a = *b;
    *b = temp;
}
int my_sort_int_array(int *array, int size)
{
    int i = 0;
    int pos_min = get_min(&array[0], size);
    while (i < size) {
        if (array[i] != array[pos_min]) {
            my_swap_int(&array[i], &array[pos_min]);
        }
           
    }
    return 0;
}
