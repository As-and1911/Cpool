#include <stddef.h>
void my_putchar(char c);
void my_putnbr(int nb)
{
    if (nb < 0) {
        my_putchar('-');
        nb = -nb;
    }
    if ( nb >= 10) {
        my_putnbr(nb / 10);
    }
    my_putchar('0' + nb%10);
}  
int get_min(int *array, int size)
{
    int i = 0;
    int idx_min = 0;
    if (array == NULL || size == 0) {
        return 0;
    }
    while (i < size) {
        if (array[i] < array[idx_min]) {
            idx_min = i;
        }
        i++;
    }
    return idx_min;
}
void my_swap_int(int *a, int *b)
{
    int temp = *a;
    *a = *b;
    *b = temp;
}
void my_sort_int_array(int *array, int size)
{
    int i = 0;
    int relative_idx;
    int absolute_idx;
    if (array == NULL || size == 0) {
        return 0;
    }
    while (i < size) {
        relative_idx = get_min(array + i, size - i);
        absolute_idx = i + relative_idx;
        if (array[i] != array[absolute_idx]) {  
            my_swap_int(&array[i], &array[absolute_idx]);
        }
        
        i++;
    }
    
}
int main(void)
{
    int i;
    int tab[10] = {23, 45, 748, 940, 7, 0, 48, 54, 36, 22};
    my_sort_int_array(tab, 10);
    for (i = 0; i < 10; i++) {
        my_putnbr(tab[i]);
        if (i != 9) {
        my_putchar(' ');
        }
    }
}

